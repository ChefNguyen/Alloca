# Template only. Local Spring Boot imports backend/.env automatically.
# Render should receive the same values as Environment Variables.
# Never commit backend/.env.

# Application
PORT=8080

# Supabase PostgreSQL
# Session Pooler is used for the Render Free IPv4 deployment.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.zbxktxgprgshfnekkgkq
SUPABASE_DB_PASSWORD=replace-with-your-local-database-password
DB_MAX_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=30000

# Sprint 1 Auth & RBAC
# Generate a random secret with at least 32 bytes. Do not reuse the database password.
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local HTTP only. In production MUST be true (the application default).
AUTH_COOKIE_SECURE=false
# Lax for same-site/proxied deployments; None requires HTTPS + Secure for cross-site.
AUTH_COOKIE_SAME_SITE=Lax

# Sprint 2+ optional integrations
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=alloca-floor-maps
R2_PUBLIC_BASE_URL=https://<public-bucket-domain>

# Optional HTTPS email provider
EMAIL_API_URL=
EMAIL_API_KEY=
