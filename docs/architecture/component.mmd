            notification["NotificationService<br/>durable notification/outbox"]
            analytics["AnalyticsService<br/>current 7 completed local days"]
            floorMap["FloorMapService<br/>day + selected interval"]
        end
        scheduler["Spring Scheduler<br/>best effort + idempotent catch-up"]
        repositories["Spring Data JPA Repositories"]
        security --> controllers
        controllers --> auth & resource & booking & notification & analytics & floorMap
        auth --> repositories
        resource --> repositories
        booking --> repositories
        notification --> repositories
        analytics --> repositories
        floorMap --> repositories
        scheduler -. "reminder/completion/current alert" .-> booking
        scheduler -.-> notification
        scheduler -.-> analytics
    end
    subgraph data["Tầng dữ liệu"]
        postgres[("Supabase Free PostgreSQL")]
        uploads[("Cloudflare R2 Free Tier<br/>ảnh sơ đồ mặt bằng")]
